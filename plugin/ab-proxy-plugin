#!/usr/bin/env python3
"""agent-browser 的 ab-proxy plugin（薄壳）。

职责仅一件事：把 agent-browser daemon 的 browser.launch / browser.close
请求转到本仓库的服务控制面（HTTP），返回代理后的 cdpUrl。

协议（agent-browser.plugin.v1，stdio JSON）：stdin 读一个请求对象，
stdout 写一个响应对象。Chrome 生命周期、tab 归属、CDP 改写全部在服务侧，
本文件不承载任何状态。

agent-browser 全局配置注册方式（~/.agent-browser/config.json）：

    {
      "provider": "ab-proxy",
      "plugins": [
        {
          "name": "ab-proxy",
          "command": "<本仓库绝对路径>/plugin/ab-proxy-plugin",
          "capabilities": ["browser.provider"]
        }
      ]
    }
"""

import json
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
CONTROL = "http://127.0.0.1:9224"
SERVE_CMD = [
    "uv", "run", "--project", str(REPO),
    "python", "-m", "agent_browser_proxy", "serve",
]
LOG_FILE = REPO / "var" / "plugin-autostart.log"
STARTUP_TIMEOUT = 60


def _http(
    method: str, path: str, body: dict | None = None, timeout: float = 30
) -> tuple[int, dict]:
    """控制面 HTTP 调用，返回 (状态码, JSON 体)。"""
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(
        CONTROL + path,
        data=data,
        method=method,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode("utf-8") or "{}")
    except urllib.error.HTTPError as exc:
        return exc.code, json.loads(exc.read().decode("utf-8") or "{}")


def _ensure_service() -> None:
    """服务不在时自动拉起（一次性，等就绪）。"""
    try:
        code, _ = _http("GET", "/health", timeout=3)
        if code == 200:
            return
    except (urllib.error.URLError, OSError):
        pass
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("ab") as log:
        subprocess.Popen(
            SERVE_CMD,
            stdout=log,
            stderr=log,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    deadline = time.monotonic() + STARTUP_TIMEOUT
    while time.monotonic() < deadline:
        try:
            code, _ = _http("GET", "/health", timeout=3)
            if code == 200:
                return
        except (urllib.error.URLError, OSError):
            pass
        time.sleep(0.5)
    raise RuntimeError(f"服务 {STARTUP_TIMEOUT}s 内未就绪")


def handle_launch(session: str) -> dict:
    """browser.launch：分配会话返回代理 cdpUrl。"""
    _ensure_service()
    code, body = _http("POST", "/sessions", {"name": session})
    if code != 200:
        raise RuntimeError(f"alloc 失败 ({code}): {body}")
    return {
        "protocol": "agent-browser.plugin.v1",
        "success": True,
        "browser": {"cdpUrl": body["cdpUrl"]},
    }


def handle_close(session: str) -> dict:
    """browser.close：释放会话（服务侧关名下 tab，基座不动）。"""
    try:
        _ensure_service()
        code, body = _http("POST", f"/sessions/{session}/release", {})
        if code != 200:
            raise RuntimeError(f"release 失败 ({code}): {body}")
    except (urllib.error.URLError, RuntimeError, OSError, KeyError) as exc:
        print(f"ab-proxy-plugin close 降级（服务不可达）: {exc}", file=sys.stderr)
    return {"protocol": "agent-browser.plugin.v1", "success": True}


def main() -> int:
    """stdio 协议主循环：读一个请求，写一个响应。"""
    raw = sys.stdin.read()
    # 请求形状审计（追加式，排障用；stderr 会被 agent-browser 压制故落文件）
    try:
        (REPO / "var").mkdir(parents=True, exist_ok=True)
        with (REPO / "var" / "plugin-requests.log").open("a") as log:
            log.write(raw.strip() + "\n")
    except OSError:
        pass
    try:
        envelope = json.loads(raw)
    except ValueError:
        print(json.dumps({
            "protocol": "agent-browser.plugin.v1",
            "success": False,
            "error": "invalid JSON request",
        }))
        return 1

    # 信封结构：{type, capability, protocol, request:{provider, session, launchOptions}}
    kind = str(envelope.get("type", ""))
    inner = envelope.get("request") or {}
    session = str(inner.get("session") or envelope.get("session") or "default")
    try:
        if kind == "browser.launch":
            response = handle_launch(session)
        elif kind == "browser.close":
            response = handle_close(session)
        else:
            response = {
                "protocol": "agent-browser.plugin.v1",
                "success": False,
                "error": f"unsupported request type: {kind}",
            }
    except (urllib.error.URLError, RuntimeError, OSError, KeyError) as exc:
        response = {
            "protocol": "agent-browser.plugin.v1",
            "success": False,
            "error": f"{type(exc).__name__}: {exc}",
        }
    print(json.dumps(response))
    return 0


if __name__ == "__main__":
    sys.exit(main())
