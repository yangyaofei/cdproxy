#!/usr/bin/env python3
"""agent-browser 的 ab-proxy plugin —— stdio 插件协议与控制面 HTTP 之间的最小桥。

为什么必须有这个文件：agent-browser 的 provider 机制只认 stdio 插件协议
（agent-browser.plugin.v1）——它需要浏览器时启动本命令，经 stdin 发一个
JSON 请求、要求 stdout 回一个 JSON 响应。它不会自己去调 HTTP API，
所以总要有一个可执行文件做这个协议桥。本文件刻意保持单文件、零第三方
依赖：将来换成任意二进制（说同样两句对话）即可无缝替换。

为什么返回的是代理地址而不是 Chrome 的：直接返回 Chrome 浏览器级 WS
地址等于所有会话共享同一视图（tab 互见、操作互相干扰——这正是本代理
要解决的问题）。这里返回的是代理的每会话端点
ws://127.0.0.1:<ws_port>/cdp/<token>；tab 归属过滤、越权拒绝、id 重映射
全部发生在代理内部（见 src/agent_browser_proxy/proxy.py）。

职责严格限定为两句翻译：
  browser.launch → POST /sessions {"name": <session>} → 回 {"browser": {"cdpUrl"}}
  browser.close  → POST /sessions/<name>/release → 回成功
服务未运行时顺带拉起（scripts/serve.sh），无其他逻辑、无状态。
"""

import json
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
CONTROL = "http://127.0.0.1:9224"
STARTUP_TIMEOUT = 60


def _http(method: str, path: str, body: dict | None = None, timeout: float = 30) -> tuple[int, dict]:
    """控制面 HTTP 调用，返回 (状态码, JSON 体)。"""
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(
        CONTROL + path,
        data=data,
        method=method,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode("utf-8") or "{}")
    except urllib.error.HTTPError as exc:
        return exc.code, json.loads(exc.read().decode("utf-8") or "{}")


def _alive() -> bool:
    """控制面是否可达。"""
    try:
        code, _ = _http("GET", "/health", timeout=3)
        return code == 200
    except (urllib.error.URLError, OSError):
        return False


def _ensure_service() -> None:
    """服务未运行时经 serve.sh 拉起并等就绪（一次性）。"""
    if _alive():
        return
    log = (REPO / "var" / "plugin-autostart.log").open("ab")
    subprocess.Popen(
        [str(REPO / "scripts" / "serve.sh")],
        stdout=log,
        stderr=log,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.monotonic() + STARTUP_TIMEOUT
    while time.monotonic() < deadline:
        if _alive():
            return
        time.sleep(0.5)
    raise RuntimeError(f"服务 {STARTUP_TIMEOUT}s 内未就绪")


def _respond(payload: dict) -> int:
    """按协议输出响应并退出。"""
    print(json.dumps(payload))
    return 0


def main() -> int:
    """stdio 协议主循环：读一个请求，写一个响应。

    信封结构：{type, capability, protocol, request:{provider, session, launchOptions}}。
    """
    try:
        envelope = json.loads(sys.stdin.read())
    except ValueError:
        return _respond({
            "protocol": "agent-browser.plugin.v1",
            "success": False,
            "error": "invalid JSON request",
        })

    kind = str(envelope.get("type", ""))
    inner = envelope.get("request") or {}
    session = str(inner.get("session") or "default")

    try:
        if kind == "browser.launch":
            _ensure_service()
            code, body = _http("POST", "/sessions", {"name": session})
            if code != 200:
                raise RuntimeError(f"alloc 失败 ({code}): {body}")
            return _respond({
                "protocol": "agent-browser.plugin.v1",
                "success": True,
                "browser": {"cdpUrl": body["cdpUrl"]},
            })
        if kind == "browser.close":
            # agent-browser 0.36.0 的 close 实际不回调 provider（回收靠断连触发，
            # 见 AGENTS.md），此分支为协议完备性保留；服务不在则静默降级。
            try:
                _ensure_service()
                _http("POST", f"/sessions/{session}/release", {})
            except (urllib.error.URLError, RuntimeError, OSError) as exc:
                print(f"ab-proxy-plugin close 降级: {exc}", file=sys.stderr)
            return _respond({"protocol": "agent-browser.plugin.v1", "success": True})
        return _respond({
            "protocol": "agent-browser.plugin.v1",
            "success": False,
            "error": f"unsupported request type: {kind}",
        })
    except (urllib.error.URLError, RuntimeError, OSError, KeyError) as exc:
        return _respond({
            "protocol": "agent-browser.plugin.v1",
            "success": False,
            "error": f"{type(exc).__name__}: {exc}",
        })


if __name__ == "__main__":
    sys.exit(main())
