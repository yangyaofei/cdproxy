{
  "manifest_version": 3,
  "name": "cdp-ext reverse bridge",
  "version": "0.1.1",
  "description": "Reverse-dial cdproxy and emulate a browser-level CDP endpoint via chrome.debugger",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "sw.js" },
  "action": {
    "default_title": "cdp-ext：点按唤醒/重连 cdproxy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html"
}
